# ============================================================================
# Agentic SRE ハンズオン 環境変数テンプレート
# 使い方: cp .env.example .env を実行し、検証用 Google Cloud プロジェクトの値を設定してください。
# 注意: 本番プロジェクトの ID や生の認証キーを Git リポジトリにコミットしないでください。
# ============================================================================

# --- Google Cloud 基本設定 ---
GOOGLE_CLOUD_PROJECT="your-sandbox-project-id"
GOOGLE_CLOUD_REGION="asia-northeast1"

# Gemini Enterprise Agent Platform 利用設定（Gemini 3.8 Flash / Embedding 2 は global エンドポイントを利用）
GOOGLE_GENAI_USE_ENTERPRISE="True"
GOOGLE_CLOUD_LOCATION="global"

# モデル設定（ハードコード禁止・環境変数で管理）
SRE_TRIAGE_MODEL="gemini-3.8-flash"
SRE_EMBEDDING_MODEL="gemini-embedding-2"

# OpenTelemetry プライバシー設定（プロンプト・ログ本文を Cloud Trace スパン属性に記録しない）
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS="false"

# --- Pub/Sub 常時監視ストリーム設定 ---
ALERT_PUBSUB_SUBSCRIPTION="sre-alert-stream-sub"

# --- BigQuery 自律埋め込み生成知識ベース・状態管理設定 ---
BQ_DATASET="sre_agent_ops"
BQ_RUNBOOKS_TABLE="incident_runbooks"
BQ_EVENTS_TABLE="incident_events"
BQ_CONNECTION_ID="sre_genai_conn"
# 承認解決後に初見インシデントの Runbook を自動生成して incident_runbooks へ登録するか
ENABLE_AUTONOMOUS_KB_LEARNING="true"
# Runbook 鮮度有効期限（最終検証日 last_verified_at からこの日数を超えた AUTO_REMEDIATE は人間再承認へ自動降格）
RUNBOOK_FRESHNESS_TTL_DAYS="90"

# --- 監視対象 GKE クラスタと安全ガードレール設定 ---
GKE_CLUSTER_NAME="sre-demo-cluster"
GKE_CLUSTER_LOCATION="asia-northeast1"
ALLOWED_K8S_NAMESPACES="sre-demo-app"
COOLDOWN_MINUTES="15"
MAX_AUTO_ACTIONS_PER_HOUR="1"
AUTO_REMEDIATE_SIMILARITY_THRESHOLD="0.85"
# ハンズオン訓練で 15 分待機せずに連続再注入するためのリセットイベント受付フラグ（本番では false）
ALLOW_DRILL_COOLDOWN_RESET="true"

# --- サンドボックス実行モード ---
# Cloud Run instances 上では "cloud_run"（/usr/local/gcp/bin/sandbox を使用）
# ローカルテスト・開発時は "local_subprocess"
SANDBOX_MODE="cloud_run"
# 初回スパイク通知後、一過性減衰と持続障害を正確に判別するための観測待機秒数（テスト時は 0、本番想定は 30）
INITIAL_STABILIZATION_SECONDS="30"

# --- Cloud Monitoring SLO & Error Budget 定量評価設定 ---
SLO_SERVICE_ID="order-service-slo"
SLO_DAILY_ID="order-availability-daily-99"
SLO_MONTHLY_ID="order-availability-monthly-999"
# 人間オンコール対応時の標準復旧時間（分）：自動復旧による Error Budget 温存量の算出基準
MANUAL_BASELINE_MTTR_MINUTES="30.0"

# --- Slack Socket Mode 連携設定（Secret Manager からの注入を推奨） ---
# Slack もメール通知も未設定の場合は、通知内容を構造化ログへ出力します
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""
SLACK_ALERT_CHANNEL_ID="C0000000000"
# 承認ボタンの押下を許可する Slack ユーザー ID（カンマ区切り、空の場合はチャンネル参加者全員を許可）
SLACK_ALLOWED_APPROVER_IDS=""

# --- Slack を使えない場合の代替ルート（メール通知 + 承認コマンド） ---
# 空のままなら無効です。Slack と併用すると、両方へ通知します。
# メール送信用の連携名（setup_email_notification.py が登録。宛先は連携の定義に固定）
EMAIL_NOTIFY_INTEGRATION=""
# 通知メールの宛先（セットアップスクリプトだけが使用。カンマ区切りで 30 件まで）
NOTIFY_EMAIL_TO=""
# 承認コマンドからの承認・却下を受け取る専用サブスクリプション（アラート用とは別に作成）
APPROVAL_PUBSUB_SUBSCRIPTION=""
# 承認コマンドが承認・却下を発行する専用トピック
APPROVAL_PUBSUB_TOPIC="sre-approval-decisions"

# --- ADK セッション & 承認待ちチケット永続化（Human-in-the-Loop 一時停止・再開用） ---
# 本番環境（Cloud Run instances）では "firestore" を推奨（再起動・再デプロイ耐性）
# ローカル単体検証時は "sqlite" を指定可能
SESSION_BACKEND="firestore"
FIRESTORE_DATABASE="(default)"
FIRESTORE_SESSIONS_COLLECTION="adk-session"
FIRESTORE_TICKETS_COLLECTION="sre_pending_approval_tickets"
# SESSION_BACKEND="sqlite" 指定時の接続 URL
SESSION_DB_URL="sqlite+aiosqlite:////tmp/sre_agent_sessions.db"
